{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/plan-siguiente-linea.py\" 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Leyendo el ledger del plan"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/puerta-de-cierre.py\"",
            "timeout": 180,
            "statusMessage": "Comprobando el cierre del ítem"
          }
        ]
      }
    ]
  }
}
